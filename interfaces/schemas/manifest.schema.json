{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pado-sat.local/schemas/manifest.schema.json",
  "title": "PADO-SAT file exchange manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["file", "type", "from", "to", "version", "created", "sha256"],
  "properties": {
    "file": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$", "not": {"enum": [".", ".."]}},
    "type": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Z0-9_]+$"},
    "from": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9-]+$"},
    "to": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "created": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
